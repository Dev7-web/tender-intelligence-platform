APP_ENV=development
# Set DEBUG=true ONLY for local development (exposes dev login OTPs in API responses).
# Leave it false for any shared, staging, or production deployment.
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=Tender Agent

MONGO_URI=mongodb://localhost:27017
DB_NAME=tender_db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:5173

LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Required when LLM_PROVIDER=ollama or local.
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-oss:latest
LLM_TIMEOUT_SECONDS=60
LLM_INPUT_MAX_CHARS=12000
LLM_GEMINI_MAX_CHARS=500000
LLM_CHUNK_SIZE=30000
LLM_CHUNK_OVERLAP=1000

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

ENABLE_SCHEDULER=false
SCRAPE_INTERVAL_HOURS=6
PROCESS_INTERVAL_MINUTES=30
PROCESS_BATCH_LIMIT=50
SCRAPE_MAX_PAGES=10
SCRAPE_MAX_BIDS=200
SCRAPER_HEADLESS=true

TENDER_PDF_DIR=data/pdfs/tenders
PROFILE_UPLOAD_DIR=data/pdfs/profiles
MAX_UPLOAD_SIZE=52428800
MAX_ONBOARDING_TOTAL_SIZE=209715200

# Required. Generate a unique random value with at least 32 characters before startup.
JWT_SECRET=
JWT_EXPIRES_MIN=60
JWT_REFRESH_EXPIRES_DAYS=30
OTP_EXPIRES_MIN=10
DEV_OTP_CODE=123456

# Central auth gateway (JWKS / RS256) — company-wide auth used by main-dashboard
AUTH_GATEWAY_BASE_URL=https://auth.nervesparks.com
AUTH_GATEWAY_PREFIX=/api/v1/auth
AUTH_JWKS_URL=https://auth.nervesparks.com/api/v1/auth/.well-known/jwks.json

EMAIL_PROVIDER=smtp
EMAIL_FROM=Tender Agent <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

WEBSITE_SCRAPE_MAX_PAGES=10
WEBSITE_SCRAPE_TIMEOUT_SECONDS=12
WEBSITE_SCRAPE_MAX_CHARS=200000

AI_RATE_LIMIT_PER_MIN=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
